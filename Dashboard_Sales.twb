      <aliases enabled='yes' />
      <column caption='Revenue' datatype='real' name='[Calculation_0778241059381249]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Status] = &quot;Success&quot; THEN [Quantity]* [Unit Price]*(1-[Discount]) END' />
      </column>
      <column caption='Profit' datatype='real' name='[Calculation_0778241059721218]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Status]= &quot;Success&quot; THEN [Quantity]*([Unit Price]*(1-[Discount])-[Unit Cost])END' />
      </column>
      <column caption='Profit Ratio' datatype='real' name='[Calculation_0778241060233219]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0778241059721218])/SUM([Calculation_0778241059381249])' />
      </column>
      <column caption='Succes Flag' datatype='integer' name='[Calculation_0778241060511748]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Status]= &quot;Success&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Success Rate' datatype='real' name='[Calculation_0778241060794373]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0778241060511748])/COUNT([Order ID])' />
